{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FinSight AI: FastAPI Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "FinSight AI: Run All Pytest Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
